#!/bin/sh
# MaruxOS - 바탕화면 새 항목 만들기
# Usage: marux-new-desktop-item <type>
# Types: folder, text, script

DESKTOP_DIR="$HOME/Desktop"
mkdir -p "$DESKTOP_DIR"

TYPE="$1"

case "$TYPE" in
    folder)
        PROMPT="New folder name"
        DEFAULT="New Folder"
        ;;
    text)
        PROMPT="New file name"
        DEFAULT="New File.txt"
        ;;
    script)
        PROMPT="New script name"
        DEFAULT="New Script.sh"
        ;;
    *)
        echo "Usage: marux-new-desktop-item <folder|text|script>"
        exit 1
        ;;
esac

# 이름 입력 받기
printf "%s [%s]: " "$PROMPT" "$DEFAULT"
read -r NAME
NAME="${NAME:-$DEFAULT}"

# 이미 존재하면 번호 붙이기
TARGET="$DESKTOP_DIR/$NAME"
if [ -e "$TARGET" ]; then
    i=2
    base="${NAME%.*}"
    ext="${NAME##*.}"
    if [ "$base" = "$ext" ]; then
        ext=""
    fi
    while [ -e "$TARGET" ]; do
        if [ -n "$ext" ] && [ "$TYPE" != "folder" ]; then
            TARGET="$DESKTOP_DIR/${base} (${i}).${ext}"
        else
            TARGET="$DESKTOP_DIR/${NAME} (${i})"
        fi
        i=$((i + 1))
    done
    NAME="$(basename "$TARGET")"
fi

# 생성
case "$TYPE" in
    folder)
        mkdir -p "$TARGET"
        echo "Folder created: $NAME"
        ;;
    text)
        touch "$TARGET"
        echo "File created: $NAME"
        ;;
    script)
        cat > "$TARGET" << 'SHEOF'
#!/bin/bash
# New Script

SHEOF
        chmod +x "$TARGET"
        echo "Script created: $NAME"
        ;;
esac

# .lnk 파일 업데이트
if [ -x /usr/bin/marux-desktop-refresh ]; then
    /usr/bin/marux-desktop-refresh --quiet
fi
# double-fork: 서브셸 안에서 idesk 시작 → 서브셸 종료 시 idesk 부모가 init(PID 1)으로 변경
# xterm이 닫혀도 idesk는 init 하위 프로세스라 영향 없음
killall idesk 2>/dev/null
sleep 0.3
( /usr/bin/idesk > /dev/null 2>&1 & )

echo "Created: $NAME"
sleep 0.5
